# Sakhi (Aura) Solo Female Travel AI Platform - Environment Variables Template
# Copy these to your Vercel Project Settings -> Environment Variables

# 1. Google Gemini Flash LLM API Key (For Sakhi AI Companion Chat & Real-Time RAG)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Cloud PostgreSQL Database Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 3. Google Maps & Places API Key (Live Places & Autocomplete)
VITE_GOOGLE_MAPS_API_KEY=AIzaSy_your_google_maps_api_key_here

# 4. OpenWeatherMap Live Weather API Key
VITE_OPENWEATHER_API_KEY=your_openweather_key_here

# 5. Exchange Rate API Key (Live Multi-Currency Conversion)
VITE_EXCHANGE_RATE_API_KEY=your_exchange_rate_key_here

# 6. Hostelworld & Booking.com Partner Keys
VITE_HOSTELWORLD_PARTNER_KEY=your_hostelworld_key_here
VITE_BOOKING_AFFILIATE_ID=your_booking_affiliate_id_here

# 7. GeoSure Live Neighborhood Safety Scores API Key
VITE_GEOSURE_SAFETY_API_KEY=your_geosure_key_here
